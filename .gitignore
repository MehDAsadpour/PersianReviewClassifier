
# =========================
# Data: large/private files
# =========================
data/raw/*
data/processed/*
data/splits/*

# Keep directory structure in Git
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/splits/.gitkeep

# =========================
# Model artifacts
# =========================
artifacts/*
!artifacts/.gitkeep

*.pt
*.pth
*.ckpt
*.safetensors
*.onnx
*.joblib
*.pkl
*.pickle

# =========================
# Python
# =========================
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/

# =========================
# Virtual environments
# =========================
.venv/
venv/
env/

# =========================
# Jupyter
# =========================
.ipynb_checkpoints/

# =========================
# Environment variables
# =========================
.env
.env.*
!.env.example

# =========================
# IDE and OS
# =========================
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# =========================
# Logs and temporary files
# =========================
*.log
logs/
tmp/
temp/

# =========================
# Test and coverage
# =========================
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# =========================
# Local experiment outputs
# =========================
wandb/
mlruns/
